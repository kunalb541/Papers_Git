\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Predictive winner map.} Cell color indicates the winning observer level; cell value is the best cross-validated score ($R^2$ for continuous targets, AUC for dominance). Dashes indicate no confirmed predictive access ($\mathrm  {CI_{lo}} \leq 0$) or targets not applicable in that regime.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:pred_map}{{3}{9}{\textbf {Predictive winner map.} Cell color indicates the winning observer level; cell value is the best cross-validated score ($R^2$ for continuous targets, AUC for dominance). Dashes indicate no confirmed predictive access ($\mathrm {CI_{lo}} \leq 0$) or targets not applicable in that regime}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Causal winner map.} Cell color indicates the winning intervention level; cell value is the winning causal gap. Only selection-driven regimes shown; random drift produces no selective causal gap. Dashes indicate no confirmed causal gap ($\mathrm  {CI}$ includes zero).}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:caus_map}{{4}{9}{\textbf {Causal winner map.} Cell color indicates the winning intervention level; cell value is the winning causal gap. Only selection-driven regimes shown; random drift produces no selective causal gap. Dashes indicate no confirmed causal gap ($\mathrm {CI}$ includes zero)}{figure.4}{}}
