\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Conservation diagnostics (direct-isolated model). Median and maximum relative energy drift $\Delta E/E_0$ and mean final virial ratio $Q_f = 2K_f/|W_f|$, aggregated over all $N$ and $\varepsilon $ within each IC family. The bimodal family reaches $Q_f \gg 1$, indicating that by $t_{\rm  final} = 3.0$ the post-merger remnant remains dynamically hot and has not yet virialised. PM periodic entries are n/a.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:diagnostics}{{1}{5}{Conservation diagnostics (direct-isolated model). Median and maximum relative energy drift $\Delta E/E_0$ and mean final virial ratio $Q_f = 2K_f/|W_f|$, aggregated over all $N$ and $\heps $ within each IC family. The bimodal family reaches $Q_f \gg 1$, indicating that by $t_{\rm final} = 3.0$ the post-merger remnant remains dynamically hot and has not yet virialised. PM periodic entries are n/a}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces N-scaling summary for all four IC families across $\varepsilon \in \{0.02, 0.05, 0.10\}$, direct-isolated. Columns show $r_{\rm  CG8}$ at each softening and the maximum $|r|$ across fine observables. The bimodal verdict is \textsc  {coarse} in every cell; verdicts for other families vary with softening.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:n_scaling}{{2}{5}{N-scaling summary for all four IC families across $\heps \in \{0.02, 0.05, 0.10\}$, direct-isolated. Columns show $r_{\rm CG8}$ at each softening and the maximum $|r|$ across fine observables. The bimodal verdict is \textsc {coarse} in every cell; verdicts for other families vary with softening}{table.2}{}}
