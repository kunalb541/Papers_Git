\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Initial condition families at $N = 512{}$, direct-isolated, $\varepsilon = 0.05$. Each panel shows projected density on a $128^2$ grid (log scale). Left to right, top to bottom: bimodal (two-cluster), Hernquist, Plummer, cold-clumpy.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:ic_gallery}{{1}{11}{Initial condition families at $N = \ShowcaseN {}$, direct-isolated, $\heps = 0.05$. Each panel shows projected density on a $128^2$ grid (log scale). Left to right, top to bottom: bimodal (two-cluster), Hernquist, Plummer, cold-clumpy}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textit  {Left}: distribution of $\log _{10}(\Delta E/E_0)$ by IC family (direct-isolated). \textit  {Centre}: initial virial ratio $Q_0 = 2K/|W|$ by family; dashed line marks virial equilibrium $Q = 1$. \textit  {Right}: energy drift vs final virial ratio. No drift-outcome correlation is present.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:diagnostics}{{2}{12}{\textit {Left}: distribution of $\log _{10}(\Delta E/E_0)$ by IC family (direct-isolated). \textit {Centre}: initial virial ratio $Q_0 = 2K/|W|$ by family; dashed line marks virial equilibrium $Q = 1$. \textit {Right}: energy drift vs final virial ratio. No drift-outcome correlation is present}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Bimodal hard anchor: $N = 1024$, $\varepsilon = 0.05$, direct-isolated, 30{} replicates. \textit  {Left}: initial $\sigma ^{2}_{\rho }(8)$ vs $\Delta C_{8}^{\mathrm  {early}}$ with least-squares fit. \textit  {Right}: $|r|$ for CoarseG8 (blue) and best fine observable (grey) vs softening $\varepsilon $. Coarse dominates at all tested softening values.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:bimodal_anchor}{{3}{12}{Bimodal hard anchor: $N = 1024$, $\heps = 0.05$, direct-isolated, \NReplicates {} replicates. \textit {Left}: initial $\sigrho (8)$ vs $\dCearly $ with least-squares fit. \textit {Right}: $|r|$ for CoarseG8 (blue) and best fine observable (grey) vs softening $\heps $. Coarse dominates at all tested softening values}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Bimodal mechanism: the inter-cluster density contrast is the predictive object. \textit  {Left}: $x$--$y$ projection of the bimodal IC with projected coarse-grid cells overlaid; cell shade $\propto $ projected particle count (illustrative; $\sigma ^{2}_{\rho }(8)$ is computed from the full 3D field). \textit  {Right}: $\sigma ^{2}_{\rho }(8)$ vs $\Delta C_{8}^{\mathrm  {early}}$ at $N = 256$ (circles) and $N = 1024$ (squares), $\varepsilon = 0.05$. The negative association persists across particle count.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:bimodal_mechanism}{{4}{13}{Bimodal mechanism: the inter-cluster density contrast is the predictive object. \textit {Left}: $x$--$y$ projection of the bimodal IC with projected coarse-grid cells overlaid; cell shade $\propto $ projected particle count (illustrative; $\sigrho (8)$ is computed from the full 3D field). \textit {Right}: $\sigrho (8)$ vs $\dCearly $ at $N = 256$ (circles) and $N = 1024$ (squares), $\heps = 0.05$. The negative association persists across particle count}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Verdict map at $N = 1024$, primary target $\Delta C_{8}^{\mathrm  {early}}$. Each cell shows $r_C$ (best coarse) and $r_f$ (best fine). Blue: \textsc  {coarse}. Green: \textsc  {fine}. Grey: tie. \textit  {Left}: direct-isolated. \textit  {Right}: PM-periodic. Bimodal is \textsc  {coarse} in all cells of both panels.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:verdict_map}{{5}{13}{Verdict map at $N = 1024$, primary target $\dCearly $. Each cell shows $r_C$ (best coarse) and $r_f$ (best fine). Blue: \textsc {coarse}. Green: \textsc {fine}. Grey: tie. \textit {Left}: direct-isolated. \textit {Right}: PM-periodic. Bimodal is \textsc {coarse} in all cells of both panels}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Time evolution: projected density (log scale, $N = 512{}$, direct-isolated). \textit  {Rows}: bimodal ($\varepsilon = 0.05$); Hernquist ($\varepsilon = 0.02$); Hernquist ($\varepsilon = 0.10$). \textit  {Columns}: $t = 0$, early, mid, final.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:snapshots}{{6}{14}{Time evolution: projected density (log scale, $N = \ShowcaseN {}$, direct-isolated). \textit {Rows}: bimodal ($\heps = 0.05$); Hernquist ($\heps = 0.02$); Hernquist ($\heps = 0.10$). \textit {Columns}: $t = 0$, early, mid, final}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Observable class vs softening: $N = 1024$, direct-isolated. Solid: VelDisp (kinematic fine). Dashed: kNN-all (positional fine). Dotted: CoarseG8 (coarse). Shaded: 95\% bootstrap CI. The VelDisp signal is present at $\varepsilon = 0.02$ for concentrated profiles and weakens with increasing $\varepsilon $. kNN-all does not outperform the coarse predictor in any cell tested.}}{14}{figure.7}\protected@file@percent }
\newlabel{fig:cond_fine}{{7}{14}{Observable class vs softening: $N = 1024$, direct-isolated. Solid: VelDisp (kinematic fine). Dashed: kNN-all (positional fine). Dotted: CoarseG8 (coarse). Shaded: 95\% bootstrap CI. The VelDisp signal is present at $\heps = 0.02$ for concentrated profiles and weakens with increasing $\heps $. kNN-all does not outperform the coarse predictor in any cell tested}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces VelDisp mechanism: Hernquist profile, $N = 512{}$. \textit  {Rows}: $\varepsilon = 0.02$ (top); $\varepsilon = 0.10$ (bottom). \textit  {Columns}: projected density (log scale); local velocity-dispersion map; median $\sigma _v^{\rm  loc}(r)$ vs radius. At small softening the kinematic structure is concentrated toward the cusp; at large softening it is washed out.}}{15}{figure.8}\protected@file@percent }
\newlabel{fig:veldisp_mechanism}{{8}{15}{VelDisp mechanism: Hernquist profile, $N = \ShowcaseN {}$. \textit {Rows}: $\heps = 0.02$ (top); $\heps = 0.10$ (bottom). \textit {Columns}: projected density (log scale); local velocity-dispersion map; median $\sigma _v^{\rm loc}(r)$ vs radius. At small softening the kinematic structure is concentrated toward the cusp; at large softening it is washed out}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Coarse advantage vs softening: $N = 1024$, direct-isolated. Each curve shows $|r_{\rm  coarse}| - |r_{\rm  best\,fine}|$ as a function of $\varepsilon $ for one IC family. Bimodal maintains a large positive advantage at all $\varepsilon $. Concentrated profiles show a suggestive fine-leaning signal at $\varepsilon = 0.02$ that weakens to tie or coarse-favoured by $\varepsilon = 0.10$.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:eps_transition}{{9}{15}{Coarse advantage vs softening: $N = 1024$, direct-isolated. Each curve shows $|r_{\rm coarse}| - |r_{\rm best\,fine}|$ as a function of $\heps $ for one IC family. Bimodal maintains a large positive advantage at all $\heps $. Concentrated profiles show a suggestive fine-leaning signal at $\heps = 0.02$ that weakens to tie or coarse-favoured by $\heps = 0.10$}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Verdict boundary in $\varepsilon /a$: coarse advantage $|r_{\rm  coarse}| - |r_{\rm  best\,fine}|$ vs the softening-to-scale-radius ratio, $N = 1024$, direct-isolated. Each point is annotated with the verdict (C = \textsc  {coarse}, F = \textsc  {fine}, T = tie). Bimodal stays above zero at all tested $\varepsilon /a$. Hernquist and Plummer show a suggestive fine-leaning signal at $\varepsilon /a \approx 0.10$ that shifts toward zero or positive between $\varepsilon /a \approx 0.10$ and $0.50$ (shaded zone).}}{16}{figure.10}\protected@file@percent }
\newlabel{fig:eps_boundary}{{10}{16}{Verdict boundary in $\heps /a$: coarse advantage $|r_{\rm coarse}| - |r_{\rm best\,fine}|$ vs the softening-to-scale-radius ratio, $N = 1024$, direct-isolated. Each point is annotated with the verdict (C = \textsc {coarse}, F = \textsc {fine}, T = tie). Bimodal stays above zero at all tested $\heps /a$. Hernquist and Plummer show a suggestive fine-leaning signal at $\heps /a \approx 0.10$ that shifts toward zero or positive between $\heps /a \approx 0.10$ and $0.50$ (shaded zone)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces N-scaling at three softening values, direct-isolated. Each panel: one IC family. Coloured lines: $r_{\rm  CG8}$ (solid/dashed/dotted for $\varepsilon = 0.02/0.05/0.10$). Grey: best fine predictor. Bimodal is stable near $-0.98$ at all $N$ and $\varepsilon $.}}{16}{figure.11}\protected@file@percent }
\newlabel{fig:n_scaling}{{11}{16}{N-scaling at three softening values, direct-isolated. Each panel: one IC family. Coloured lines: $r_{\rm CG8}$ (solid/dashed/dotted for $\heps = 0.02/0.05/0.10$). Grey: best fine predictor. Bimodal is stable near $-0.98$ at all $N$ and $\heps $}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Force-model comparison: $r_{\rm  CG8}$ vs $\varepsilon $, $N = 1024$. Blue: direct-isolated. Brown: PM-periodic. Shaded: 95\% CI. Both models agree on the bimodal verdict. Concentrated profiles show quantitative differences but the same qualitative pattern.}}{16}{figure.12}\protected@file@percent }
\newlabel{fig:model_comparison}{{12}{16}{Force-model comparison: $r_{\rm CG8}$ vs $\heps $, $N = 1024$. Blue: direct-isolated. Brown: PM-periodic. Shaded: 95\% CI. Both models agree on the bimodal verdict. Concentrated profiles show quantitative differences but the same qualitative pattern}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Summary matrix: Pearson $r$ with $\Delta C_{8}^{\mathrm  {early}}$ by IC family (rows), observable class (groups), and $\varepsilon $ (within-group columns), at $N = 1024$, direct-isolated. The coarse group (leftmost) shows strong negative $r$ for bimodal at all $\varepsilon $. VelDisp (fine kinematic) shows the strongest fine signal for Hernquist and Plummer at $\varepsilon = 0.02$. No tested positional fine observable outperforms the coarse predictor in any cell.}}{17}{figure.13}\protected@file@percent }
\newlabel{fig:summary_matrix}{{13}{17}{Summary matrix: Pearson $r$ with $\dCearly $ by IC family (rows), observable class (groups), and $\heps $ (within-group columns), at $N = 1024$, direct-isolated. The coarse group (leftmost) shows strong negative $r$ for bimodal at all $\heps $. VelDisp (fine kinematic) shows the strongest fine signal for Hernquist and Plummer at $\heps = 0.02$. No tested positional fine observable outperforms the coarse predictor in any cell}{figure.13}{}}
