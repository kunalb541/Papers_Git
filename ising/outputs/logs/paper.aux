\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Axis 4 sign-flip ladder.} Gap = baseline $-$ arm on $\Delta W$. Positive: arm loses fewer walls. Negative: arm loses more. 4/4{} sign flips.}}{7}{table.caption.19}\protected@file@percent }
\newlabel{tab:axisB}{{2}{7}{\textbf {Axis 4 sign-flip ladder.} Gap = baseline $-$ arm on $\Delta W$. Positive: arm loses fewer walls. Negative: arm loses more. \AxisBSignFlips {} sign flips}{table.caption.19}{}}
\@writefile{toc}{\contentsline {paragraph}{Why sign flip $\neq  $ generic perturbation.}{7}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Direction-specific generator causal test.} Bars: gap (baseline $-$ arm) on $\Delta W$. Blue (aligned): promoting wall-reducing flips at exposed sites reduces future wall loss. Red (misaligned): suppressing those flips increases wall loss. All four $\varepsilon $ values produce a sign flip (\text  {$\mathsurround \z@ \mathchar "458$}{}): aligned CI $>0$, misaligned CI $<0$, both excluding zero. The sign reversal supports the interpretation that the effect is structurally specific, rather than a generic perturbation effect.}}{8}{figure.caption.17}\protected@file@percent }
\newlabel{fig:axis4_main}{{4}{8}{\textbf {Direction-specific generator causal test.} Bars: gap (baseline $-$ arm) on $\Delta W$. Blue (aligned): promoting wall-reducing flips at exposed sites reduces future wall loss. Red (misaligned): suppressing those flips increases wall loss. All four $\varepsilon $ values produce a sign flip (\checkmark {}): aligned CI $>0$, misaligned CI $<0$, both excluding zero. The sign reversal supports the interpretation that the effect is structurally specific, rather than a generic perturbation effect}{figure.caption.17}{}}
