\newlabel{tab:main}{{1}{3}{Local-loss difference (targeted $-$ random) at $L=6$, $N_{\mathrm {trials}}=100$ per condition. Format: mean $[\text {95\% CI}]$. $J/U=0.12$ is uniformly negative (boundary regime)}{table.caption.1}{}}
