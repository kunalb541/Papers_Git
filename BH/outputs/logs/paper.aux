\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Local-loss difference at $J/U=0.30$ and $0.40$ for $L=6$ and $L=7$. Error bars are 95\% bootstrap CIs. The positive pocket persists across both chain lengths.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:robustness}{{2}{5}{Local-loss difference at $J/U=0.30$ and $0.40$ for $L=6$ and $L=7$. Error bars are 95\% bootstrap CIs. The positive pocket persists across both chain lengths}{figure.caption.4}{}}
