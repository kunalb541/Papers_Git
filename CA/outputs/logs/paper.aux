\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Key statistics for the observer-disagreement analysis ($N=1000$, $64\times 64$ GoL, $t_{\rm  early}=50$, $B_{\rm  coarse}=8$).}}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:A}{{2}{3}{Key statistics for the observer-disagreement analysis ($N=1000$, $64\times 64$ GoL, $t_{\rm early}=50$, $B_{\rm coarse}=8$)}{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Observer-disagreement main result. Early fine-scale component net change $\Delta _{\mathrm  {early}}$ predicts the full-run narrative gap $G$. Points are worlds coloured by initial density. The relationship sharpens after density control: raw $r=-0.765$, partial $r(\Delta _{\mathrm  {early}},G\mid \rho )=-0.848$, 95\% bootstrap CI $[-0.862,-0.830]$. }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:studyA_scatter}{{1}{4}{Observer-disagreement main result. Early fine-scale component net change $\Dearly $ predicts the full-run narrative gap $G$. Points are worlds coloured by initial density. The relationship sharpens after density control: raw $r=-0.765$, partial $r(\Dearly ,G\mid \rho )=-0.848$, 95\% bootstrap CI $[-0.862,-0.830]$}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Illustrative observer trajectories for a representative positive-gap world (left, $G=0.621$) and a representative negative-gap world (right, $G=-0.321$). Fine and coarse observers can accumulate opposite net-change narratives over the same deterministic run. Yellow shading marks the early window $[0,50]$ used to compute $\Delta _{\mathrm  {early}}$. These panels are descriptive only and are not used in the inferential test. }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:studyA_traces}{{2}{5}{Illustrative observer trajectories for a representative positive-gap world (left, $G=0.621$) and a representative negative-gap world (right, $G=-0.321$). Fine and coarse observers can accumulate opposite net-change narratives over the same deterministic run. Yellow shading marks the early window $[0,50]$ used to compute $\Dearly $. These panels are descriptive only and are not used in the inferential test}{figure.caption.5}{}}
